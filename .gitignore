slurm_*.sh
submit_*.sh

# Theory
Theory/

# Reviews
reviews/

# Public manuscript source and generated submission figures
!manuscript/
manuscript/*
!manuscript/manuscript.tex
!manuscript/manuscript_original.tex
!manuscript/manuscript_original.pdf
!manuscript/refs_original.bib
!manuscript/manuscript_clean.tex
!manuscript/manuscript_clean.pdf
