# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg

# ── Virtual environment ───────────────────────────────────────────────────────
.venv
.venv/
venv/
env/

# ── VASP calculation run directories ─────────────────────────────────────────
# These contain large OUTCAR / CHG / WAVECAR files (100s of MB)
sqtc_*_run/

# ── SLURM job output ──────────────────────────────────────────────────────────
job.err.*
job.out.*

# ── Generated plots and large data at repo root ───────────────────────────────
*.png
*.pdf
*.npz

# Allow plots that live inside codes/ (e.g. test reference images)
!codes/**/*.png
!codes/**/*.pdf

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp

# ── Theory (internal derivations, not for public repo) ───────────────────────
Theory/

# --manuscript
manuscript/

# slurm job output / error logs
*.out.*
*.err.*

# examples
examples/

# qe scratch
qe_scratch/

# scripts
scripts/

# logs
logs/

# examples_old
codes/examples_old/

# slurm scripts
slurm_*.sh
submit_*.sh

# Theory
Theory/

# Compact validation results are public; transient QE/HPC artifacts stay local
validation_results/**/*.out
validation_results/**/*.err
validation_results/**/scratch/
validation_results/**/thermal_qe/
validation_results/**/fc4_compact.npy
validation_results/mgo/dfpt_nac/
validation_results/pbte/dfpt_nac/
core.*

# Compact arrays required to reproduce revised polar-dispersion figures
!validation_results/nacl/dfpt_nac/nac_tensors.npz
!validation_results/nacl/dfpt_nac/nacl_loto_dispersion.npz
!validation_results/mgo/dfpt_nac_production_volume/nac_tensors.npz
!validation_results/pbte/dfpt_nac_production_volume/nac_tensors.npz
!validation_results/al/matched_sampling/matched_sampling_summary.json
!validation_results/w/matched_sampling/matched_sampling_summary.json
!validation_results/nacl/matched_sampling/matched_sampling_summary.json
!validation_results/nacl/production_sotc_nac/production_sotc_nac_bands.npz
!validation_results/mgo/production_sotc_nac/production_sotc_nac_bands.npz
!validation_results/pbte/production_sotc_nac/production_sotc_nac_bands.npz

# SSCHA scratch dynamical matrices written to the working directory
dyn_pop*

# Per-material run directories live on scratch (symlinked); compact copies
# of every result used in the paper are in validation_results/summaries/
validation_results/*.log
validation_results/*/fd_references
validation_results/*/primary_audit
validation_results/*/primary_cell
validation_results/*/robustness
validation_results/si/real_ifc34
validation_results/mg/real_ifc34
